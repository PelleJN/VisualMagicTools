#! C:/Program Files/Nuke16.0v6/nuke-16.0.6.dll -nx
version 16.0 v6
Gizmo {
 inputs 0
 tile_color 0xffff
 addUserKnob {20 Main}
 addUserKnob {41 format t aaa T Constant6.format}
 addUserKnob {41 WorleyNoise_Amount l Amount t "Amount\nA global multiplier for the noise brightness. Default is 1.0." T WorleyNoise0.WorleyNoise_Amount}
 addUserKnob {41 WorleyNoise_Scale l Scale t "Scale\nControls the global size of the noise pattern. Lower values create smaller, denser details (high frequency); higher values create larger, zoomed-in features (low frequency)" T WorleyNoise0.WorleyNoise_Scale}
 addUserKnob {41 WorleyNoise_Translate l Translate t "Moves the noise pattern across the X, Y, and Z coordinates. Animate Z " T WorleyNoise0.WorleyNoise_Translate}
 addUserKnob {41 WorleyNoise_Rotation l Rotation T WorleyNoise0.WorleyNoise_Rotation}
 addUserKnob {41 WorleyNoise_Jitter l Jitter t "Controls the randomness of the cell center positions. 0.0 = Perfect Grid (Robotic) 1.0 = Fully Random (Organic) (Only affects Cellular/Worley noise types)." T WorleyNoise0.WorleyNoise_Jitter}
 addUserKnob {41 WorleyNoise_PixelSize l "Pixel Size" t "Pixelates the output for a mosaic/retro effect. A value of 1 is standard resolution. Higher values create larger pixel blocks." T "WorleyNoise0.WorleyNoise_Pixel Size"}
 addUserKnob {4 NoiseType t "Selects the algorithm used to generate the pattern. 0-9 are Cellular (Voronoi) variations; 10-11 are Cloud/Perlin types; 12+ are Geometric patterns like Gyroids or Stripes." M {"F1 (Cells)" "F2 (Points)" "Crackle (F2-F1)" "Midpoint (F1+F2)" "Intersection (F1*F2)" "Smooth Min (Organic)" "Soft Borders" "Complex Web (F3-F1)" "Thinner Web (F4-F1)" Pebbles Rings "Stepped (Quantized)" Voro-Noise "Cell ID (Random Color)" "Value Noise (Clouds)" "Gradient Noise (Perlin)" "Gyroid (Sponge)" Stripes Checkerboard ""}}
 addUserKnob {4 DistanceType M {Euclidean Manhattan Chebyshev Stars/Squircle "" ""}}
 addUserKnob {41 WorleyNoise_Lacunarity l Lacunarity t "Lacunarity\nDetermines how much the frequency (size) changes with each octave. A value of 2.0 means each new layer is half the size of the previous one." T WorleyNoise0.WorleyNoise_Lacunarity}
 addUserKnob {41 WorleyNoise_Octaves l Octaves T WorleyNoise0.WorleyNoise_Octaves}
 addUserKnob {41 WorleyNoise_Gain l Gain t "Determines how much the amplitude (brightness) decreases with each octave. Lower values make the fine details subtler." T WorleyNoise0.WorleyNoise_Gain}
 addUserKnob {41 WorleyNoise_Gamma l Gamma t "Adjusts the mid-tone contrast of the noise. Values < 1.0 brighten the mid-tones; values > 1.0 darken them, making the noise appear sharper." T WorleyNoise0.WorleyNoise_Gamma}
 addUserKnob {6 Invert +STARTLINE}
 Invert true
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {26 Author l "" +STARTLINE T "<span style=\"color:#666\"><br/><b>WorleyNoise</b> - <a href=\"http://\" style=\"color:#666;text-decoration: none;\">Lukas-Kelloniemi</a>, 2025</span>"}
 addUserKnob {20 Shapeing}
 addUserKnob {41 WorleyNoise_EdgeWidth l "Edge Width" t "Controls the softness of the cell borders. (Only active when Noise Type is set to 'Soft Borders')." T "WorleyNoise0.WorleyNoise_Edge Width"}
 addUserKnob {41 WorleyNoise_Smoothness l Smoothness t "Controls the blending radius between cells, creating a 'Metaball' organic fusion effect. (Only active when Return Type is set to 'Smooth Min' or 'Voro-Noise')." T WorleyNoise0.WorleyNoise_Smoothness}
 addUserKnob {41 WorleyNoise_RemapBlack l "Remap Black" t "Sets the black point. Noise values equal to or lower than this will become 0." T "WorleyNoise0.WorleyNoise_Remap Black"}
 addUserKnob {41 WorleyNoise_RemapWhite l "Remap White" t "Sets the white point. Noise values equal to or higher than this will become 1." T "WorleyNoise0.WorleyNoise_Remap White"}
 addUserKnob {41 WorleyNoise_NormalizeFractalSum l "Normalize Fractal Sum" t "If enabled, ensures the sum of all fractal layers is divided by the total amplitude, keeping values within the 0-1 range. Useful to prevent white clipping when using high Octaves." T "WorleyNoise0.WorleyNoise_Normalize Fractal Sum"}
 addUserKnob {20 Warping}
 addUserKnob {41 WorleyNoise_WarpAmount l "Warp Amount" t "Applies domain distortion to the coordinates before generating the noise. Creates a fluid, marbled, or melted look." T "WorleyNoise0.WorleyNoise_Warp Amount"}
 addUserKnob {41 WorleyNoise_WarpOctaves l "Warp Octaves" t "Controls the complexity and detail of the distortion pattern itself.\n\n" T "WorleyNoise0.WorleyNoise_Warp Octaves"}
 addUserKnob {41 WorleyNoise_WarpFrequency l "Warp Frequency" t "Controls the scale/tightness of the distortion pattern. Higher values create tighter, more turbulent swirls." T "WorleyNoise0.WorleyNoise_Warp Frequency"}
 addUserKnob {20 Output}
 addUserKnob {20 ProgramGroup l "Kernel Source: WorleyNoise" n 2}
 ProgramGroup 1
 addUserKnob {41 WorleyNoise_OutputNormals l "Output Normals" t "If enabled, the node outputs an RGB Normal Map (tangent space) instead of a Grayscale Height Map. Useful for relighting or bump mapping" T "WorleyNoise0.WorleyNoise_Output Normals"}
 addUserKnob {41 WorleyNoise_NormalScale l "Normal Scale" t "Controls the intensity (steepness) of the generated normal map. Higher values make the surface look rougher and deeper." T "WorleyNoise0.WorleyNoise_Normal Scale"}
 addUserKnob {41 WorleyNoise_OutputtoAlpha l "Output to Alpha" t "If enabled, the generated noise is copied into the Alpha channel. If disabled, the original input Alpha is preserved." T "WorleyNoise0.WorleyNoise_Output to Alpha"}
}
